# Copy to server/.env and adjust for your machine.
# Compose maps Postgres to host port 5433 (avoids clash with a local Postgres).
DATABASE_URL=postgres://lifeline:lifeline@localhost:5433/lifeline
PORT=8787
BEACON_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
BEACON_DEMO_PASSWORD=demo-only-password
